# --- Majburiy ---
NODE_ENV=production
PORT=3000
# Saytning to'liq manzili (https bilan). Bot Mini App tugmasi shu manzilni ochadi.
PUBLIC_URL=https://example.uz
# DATABASE_URL docker-compose ichida avtomatik beriladi
# Kamida 32 belgili tasodifiy satr: openssl rand -hex 32
JWT_SECRET=

# --- Telegram bot (@BotFather) ---
BOT_TOKEN=
BOT_USERNAME=
# Admin(lar)ning Telegram ID raqami, vergul bilan (@userinfobot orqali bilish mumkin)
ADMIN_TELEGRAM_IDS=
# polling (oddiy) yoki webhook
BOT_MODE=polling
WEBHOOK_SECRET=

# --- Marketapp ---
MARKETAPP_TOKEN=
MARKETAPP_BASE_URL=https://api.marketapp.org

# UPLOAD_DIR docker-compose ichida beriladi

# --- Docker ---
DB_PASSWORD=
